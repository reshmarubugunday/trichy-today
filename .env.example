# Copy to .env.local and fill in from Supabase Project Settings → API

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 1, later steps (leave blank until those are wired up)
MSG91_AUTH_KEY=

# RSS ingestion worker — bearer token for the manual/test trigger route
# (app/api/cron/rss-ingest). Generate any random string, e.g. `openssl rand -hex 32`.
RSS_INGEST_SECRET=
